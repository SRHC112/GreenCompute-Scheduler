# 绿算调度 GreenCompute-Scheduler — 大模型网关配置模板
#
# 本项目可以完全离线运行（默认使用内置确定性模拟模型，不产生任何 API 调用）。
# 如需接入国内大模型（OpenAI 兼容接口，如 DeepSeek / GLM / Qwen / Doubao），
# 将本文件复制一份为 `.env` 并填写下列信息。`.env` 本身不入仓（已在 .gitignore 中屏蔽）。

# 模型服务的 Base URL，末尾斜杠会被自动去掉。
# 留空则进入离线模拟模式（offline-mock），结果可复现、不消耗额度。
GCS_LLM_BASE_URL=https://api.deepseek.com/v1/

# 接口密钥。只有 Base URL 与 API Key 同时非空时，网关才判定为“在线”。
GCS_LLM_API_KEY=sk-your-key-here

# 模型名称，例如 deepseek-chat / glm-4 / qwen-plus 等；留空时使用模型默认值。
GCS_LLM_MODEL=deepseek-chat

# 轻量模型名称（可选），例如 qwen-turbo / glm-4-flash；供 light 层短任务使用。
# 留空时 light 层自动回落主模型，行为与单模型配置完全一致。
GCS_LLM_LITE_MODEL=

# 单次运行的 token 预算（可选，默认 600,000）。预算耗尽后抛出 BudgetExceeded，
# 引擎降级回离线模拟，结论不变。
GCS_LLM_TOKEN_BUDGET=600000
