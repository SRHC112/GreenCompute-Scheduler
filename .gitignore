# 运行产物（每次运行都会重新生成，不入仓，但保留空目录占位）
# 注意：写成 runs/ 会让下面的 !runs/.gitkeep 失效，必须用 runs/*
runs/*
!runs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# 本地密钥（模型 API 配置绝不入仓）
.env
.env.local

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 临时文件与日志
evaluation/*.tmp
*.log
