# 运行产物（每次运行都会重新生成，不入仓，但保留空目录占位）
# 注意：写成 runs/ 会让下面的 !runs/.gitkeep 失效，必须用 runs/*
runs/*
!runs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# 本地密钥（模型 API 配置绝不入仓）
.env
.env.local

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 临时文件与日志
evaluation/*.tmp
*.log

# 安装脚本生成的运行入口与只读预检探针（不入库）
run.bat
run.sh
.gcs_install_probe

# 本地密钥的所有变体（模板必须显式放行，否则会把 .env.example 一起忽略掉）
.env*
!.env.example

# 一次性调试脚本与其输出（定位在仓库根，属临时文件）
v.txt
doc_miss.py
doc_perf.py

# 评测产物分类（P1-2.7）：作品证据随仓库提交并纳入参赛包；
# 一次性调参中间产物不入库。summary.md 引用的五份 JSON 均属前者。
evaluation/*.json
!evaluation/summary.json
!evaluation/sensitivity.json
!evaluation/pareto.json
!evaluation/ci_bootstrap.json
!evaluation/diff_ci.json
evaluation/trace_fit.json
evaluation/traces/
